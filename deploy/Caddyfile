# 갈곳 배포 주소(예: galgot.duckdns.org). Caddy가 Let's Encrypt 인증서를 자동으로 받고 갱신한다.
{$SITE_ADDRESS} {
	encode zstd gzip

	# 백엔드(Spring)로 넘길 경로: API, 카카오 로그인 시작(/oauth2)과 돌아오는 주소(/login/oauth2)
	@backend path /api/* /oauth2/* /login/oauth2/*
	handle @backend {
		reverse_proxy app:8080
	}

	# 나머지는 React 화면. /places/3, /my, /s/... 처럼 주소로 바로 들어와도 index.html을 돌려준다
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
