# 서버에서 이 파일을 .env로 복사한 뒤 값을 채운다: cp .env.example .env ; chmod 600 .env
# .env는 git에 올리지 않는다(.gitignore). 값에 따옴표는 붙이지 않는다.

# 배포 주소
SITE_ADDRESS=galgot.duckdns.org
PUBLIC_URL=https://galgot.duckdns.org

# DB (서버에서 새로 정하는 비밀번호. 영문·숫자로 길게)
DB_USERNAME=galgot
DB_PASSWORD=
DB_ROOT_PASSWORD=

# 카카오 로그인(REST API 키, Client Secret)과 카카오 지도(JavaScript 키)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
VITE_KAKAO_MAP_KEY=

# 공공데이터포털(TourAPI, 기상청) 서비스 키
TOURAPI_SERVICE_KEY=
KMA_SERVICE_KEY=

# 장소 실내/야외 분류를 앱 시작 때 다시 돌릴지(데이터를 옮긴 뒤 필요할 때만 true)
CLASSIFY_RUN_ON_STARTUP=false
